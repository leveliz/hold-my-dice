rules_version = '2';

// Security rules of the multi-device mode. See the phase 7 spec: a room is
// rooms/{code} (meta), with seats, members, presence, state, entries and
// requests under it. Tested by firebase_tests/rules.test.mjs.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function roomDoc(code) {
      return /databases/$(database)/documents/rooms/$(code);
    }

    function seatDoc(code, id) {
      return /databases/$(database)/documents/rooms/$(code)/seats/$(id);
    }

    function memberDoc(code, id) {
      return /databases/$(database)/documents/rooms/$(code)/members/$(id);
    }

    function presenceDoc(code, id) {
      return /databases/$(database)/documents/rooms/$(code)/presence/$(id);
    }

    function statePath(code) {
      return /databases/$(database)/documents/rooms/$(code)/state/current;
    }

    function entryPath(code, id) {
      return /databases/$(database)/documents/rooms/$(code)/entries/$(id);
    }

    function isMember(code) {
      return signedIn() && exists(memberDoc(code, request.auth.uid));
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 20;
    }

    function validMoney(n) {
      return n is int && n >= 1 && n <= 999999999;
    }

    function validSettings(s) {
      return s is map
        && s.keys().hasOnly(['startingCash', 'goAmount', 'hideOthers',
                             'allowSpectators', 'bankLimit', 'maxPlayers'])
        && s.keys().hasAll(['startingCash', 'goAmount', 'hideOthers',
                            'allowSpectators', 'bankLimit', 'maxPlayers'])
        && validMoney(s.startingCash)
        && validMoney(s.goAmount)
        && s.hideOthers is bool
        && s.allowSpectators is bool
        && (s.bankLimit == null || validMoney(s.bankLimit))
        && s.maxPlayers is int && s.maxPlayers >= 2 && s.maxPlayers <= 8;
    }

    // A password is a 64-character SHA-256 hash; no password means no hash.
    function validPassword(d) {
      return d.hasPassword is bool
        && (d.hasPassword
            ? (d.passwordHash is string && d.passwordHash.size() == 64)
            : d.passwordHash == null);
    }

    function statusMoves(from, to) {
      return (from == 'lobby' && (to == 'lobby' || to == 'playing'))
        || (from == 'playing' && (to == 'playing' || to == 'ended'))
        || (from == 'ended' && to == 'ended');
    }

    // The password hash the joiner sends must match the room's.
    function passwordOk(room, d) {
      return !room.hasPassword || d.get('pwHash', null) == room.passwordHash;
    }

    // The starting position of a game: the seats that play, each holding the
    // starting cash, plus a bank balance exactly when the room has a bank.
    function validStart(d, settings) {
      return d.keys().hasOnly(['v', 'seq', 'seats', 'balances', 'bankrupt',
                               'bankerSeat', 'status'])
        && d.keys().hasAll(['v', 'seq', 'seats', 'balances', 'bankrupt',
                            'bankerSeat', 'status'])
        && d.v == 1
        && d.seq == 0
        && d.status == 'playing'
        && d.bankrupt == []
        && d.bankerSeat == null
        && d.seats is list
        && d.seats.size() >= 2
        && d.seats.size() <= settings.maxPlayers
        && d.seats.toSet().size() == d.seats.size()
        && d.seats.hasOnly(['p1', 'p2', 'p3', 'p4', 'p5', 'p6', 'p7', 'p8'])
        && d.balances is map
        && d.balances.keys().hasAll(d.seats)
        && (settings.bankLimit == null
            ? d.balances.size() == d.seats.size()
              && d.balances.values().hasOnly([settings.startingCash])
            : d.balances.size() == d.seats.size() + 1
              && d.balances.bank == settings.bankLimit
              && d.balances.values().hasOnly([settings.startingCash,
                                              settings.bankLimit]));
    }

    // A reason that says something: text of at most 60 UTF-16 units that is
    // not only spaces.
    function validReason(r) {
      return r is string && r.size() >= 1 && r.size() <= 60
        && r.matches('.*\\S.*');
    }

    // What an entry does to the balances: the seat of the person who pressed
    // moves by [delta], the bank (only when the room gives it a limit) moves
    // the other way, and nothing else changes. Whole numbers only, none below 0.
    function balancesMove(before, after, seat, delta) {
      return before is map && after is map
        && after.size() == before.size()
        && after.diff(before).affectedKeys().hasOnly([seat, 'bank'])
        && after[seat] is int && after[seat] >= 0
        && after[seat] == before[seat] + delta
        && ('bank' in before
            ? 'bank' in after && after.bank is int && after.bank >= 0
              && after.bank == before.bank - delta
            : !('bank' in after));
    }

    // What a transfer does to the balances: [from] gives [amount], [to] gets
    // it, the bank (when the room has one) stays as it is, nothing else moves.
    function balancesTransfer(before, after, from, to, amount) {
      return before is map && after is map
        && after.size() == before.size()
        && after.diff(before).affectedKeys().hasOnly([from, to])
        && after[from] is int && after[from] >= 0
        && after[from] == before[from] - amount
        && after[to] is int && after[to] >= 0
        && after[to] == before[to] + amount
        && ('bank' in before
            ? 'bank' in after && after.bank == before.bank
            : !('bank' in after));
    }

    // A line of the history, written in the same transaction as the new state.
    // Four kinds: receive from the bank (with a reason), pass GO, pay the bank
    // and transfer to another player.
    function validEntry(code, entryId, d) {
      let state = get(statePath(code)).data;
      let stateAfter = getAfter(statePath(code)).data;
      let room = get(roomDoc(code)).data;
      return signedIn()
        && d.keys().hasOnly(['v', 'seq', 'by', 'seat', 'at', 'kind', 'from',
                             'to', 'amount', 'reason', 'cid', 'voided'])
        && d.keys().hasAll(['v', 'seq', 'by', 'seat', 'at', 'kind', 'from',
                            'to', 'amount', 'reason', 'cid', 'voided'])
        && d.v == 1
        && d.seq is int
        && entryId == string(d.seq)
        && d.seq == state.seq
        && stateAfter.seq == d.seq + 1
        && room.status == 'playing'
        && d.by == request.auth.uid
        && d.seat is string && d.seat.matches('p[1-8]')
        && get(seatDoc(code, d.seat)).data.uid == request.auth.uid
        && d.seat in state.seats && !(d.seat in state.bankrupt)
        && d.at == request.time
        && d.voided == false
        && d.cid is string && d.cid.size() >= 8 && d.cid.size() <= 40
        && d.amount is int && d.amount >= 1 && d.amount <= 999999999
        && (d.kind == 'receive'
            ? d.from == 'bank' && d.to == d.seat && validReason(d.reason)
              && balancesMove(state.balances, stateAfter.balances, d.seat,
                              d.amount)
            : d.kind == 'passGo'
            ? d.from == 'bank' && d.to == d.seat
              && d.amount == room.settings.goAmount
              && d.reason == 'ผ่านจุดเริ่ม'
              && balancesMove(state.balances, stateAfter.balances, d.seat,
                              d.amount)
            : d.kind == 'transfer'
            ? d.from == d.seat
              && d.to is string && d.to != d.seat
              && d.to in state.seats && !(d.to in state.bankrupt)
              && (d.reason == null || validReason(d.reason))
              && balancesTransfer(state.balances, stateAfter.balances, d.seat,
                                  d.to, d.amount)
            : d.kind == 'payBank'
              && d.from == d.seat && d.to == 'bank'
              && (d.reason == null || validReason(d.reason))
              && balancesMove(state.balances, stateAfter.balances, d.seat,
                              -d.amount));
    }

    // Taking back an entry: the latest of the whole game, the person's own,
    // within 6.5 seconds of the server's time. Only `voided` changes, and the
    // balances go back in the same batch (checked here through getAfter).
    function validVoid(code, entryId, old, d) {
      let state = get(statePath(code)).data;
      let stateAfter = getAfter(statePath(code)).data;
      return signedIn()
        && get(roomDoc(code)).data.status == 'playing'
        && d.diff(old).affectedKeys().hasOnly(['voided'])
        && old.voided == false && d.voided == true
        && old.kind in ['receive', 'passGo', 'payBank', 'transfer']
        && !(old.kind == 'transfer' && old.reason == 'ตามคำขอเรียกเก็บ')
        && old.by == request.auth.uid
        && get(seatDoc(code, old.seat)).data.uid == request.auth.uid
        && entryId == string(state.seq - 1)
        && request.time < old.at + duration.value(6500, 'ms')
        && stateAfter.seq == state.seq
        && (old.kind == 'transfer'
            ? balancesTransfer(state.balances, stateAfter.balances, old.to,
                               old.seat, old.amount)
            : old.kind == 'payBank'
            ? balancesMove(state.balances, stateAfter.balances, old.seat,
                           old.amount)
            : balancesMove(state.balances, stateAfter.balances, old.seat,
                           -old.amount));
    }

    // A new request to pay: asked by the owner of [toSeat] of a player who is
    // still in the game, with the id the pair has, stamped with the server's
    // time. Nothing else is in it.
    function validNewRequest(code, reqId, d) {
      let state = get(statePath(code)).data;
      return signedIn()
        && d.keys().hasOnly(['fromSeat', 'toSeat', 'amount', 'status',
                             'createdAt', 'paidSeq'])
        && d.keys().hasAll(['fromSeat', 'toSeat', 'amount', 'status',
                            'createdAt', 'paidSeq'])
        && d.fromSeat is string && d.fromSeat.matches('p[1-8]')
        && d.toSeat is string && d.toSeat.matches('p[1-8]')
        && d.fromSeat != d.toSeat
        && reqId == d.toSeat + '_' + d.fromSeat
        && validMoney(d.amount)
        && d.status == 'open'
        && d.createdAt == request.time
        && d.paidSeq == null
        && get(roomDoc(code)).data.status == 'playing'
        && get(seatDoc(code, d.toSeat)).data.uid == request.auth.uid
        && d.fromSeat in state.seats && d.toSeat in state.seats
        && !(d.fromSeat in state.bankrupt) && !(d.toSeat in state.bankrupt);
    }

    // The payer settles a request: only `status` and `paidSeq` change, in time,
    // and the transfer that pays it is written in the same batch.
    function validRequestPaid(code, old, d) {
      let state = get(statePath(code)).data;
      let paid = getAfter(entryPath(code, string(state.seq))).data;
      return signedIn()
        && d.diff(old).affectedKeys().hasOnly(['status', 'paidSeq'])
        && old.status == 'open' && d.status == 'paid'
        && d.paidSeq == state.seq
        && get(roomDoc(code)).data.status == 'playing'
        && get(seatDoc(code, old.fromSeat)).data.uid == request.auth.uid
        && request.time < old.createdAt + duration.value(2, 'm')
        && paid.kind == 'transfer'
        && paid.from == old.fromSeat && paid.to == old.toSeat
        && paid.amount == old.amount
        && paid.reason == 'ตามคำขอเรียกเก็บ'
        && paid.by == request.auth.uid;
    }

    // ---- rooms/{code} --------------------------------------------------

    match /rooms/{code} {
      // Anyone signed in who knows the code may look at one room, but rooms
      // cannot be listed.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['v', 'ownerUid', 'status', 'createdAt', 'settings',
              'hasPassword', 'passwordHash'])
        && request.resource.data.keys().hasAll(
             ['v', 'ownerUid', 'status', 'createdAt', 'settings',
              'hasPassword', 'passwordHash'])
        && request.resource.data.v == 1
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.createdAt == request.time
        && validSettings(request.resource.data.settings)
        && validPassword(request.resource.data);

      // The owner moves the status forward; settings and password can change
      // only while in the lobby.
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.v == 1
        && statusMoves(resource.data.status, request.resource.data.status)
        && (resource.data.status == 'lobby'
            ? request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'settings', 'hasPassword', 'passwordHash'])
              && validSettings(request.resource.data.settings)
              && validPassword(request.resource.data)
            : request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status']));

      // A member takes over a lobby whose owner has not been seen for 2
      // minutes: only ownerUid changes, and it becomes the member's own uid.
      allow update: if isMember(code)
        && resource.data.status == 'lobby'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && get(presenceDoc(code, resource.data.ownerUid)).data.lastSeen
             < request.time - duration.value(2, 'm');

      allow delete: if false;

      // ---- seats -------------------------------------------------------
      // The seat says who sits where and is the authority for "who is p3".
      // Readable one at a time by anyone signed in (so a person who lost their
      // identity can see which seats exist); never listed.
      match /seats/{seatId} {
        allow get: if signedIn();
        allow list: if false;

        // Sitting down: only in the lobby, a free seat number up to
        // maxPlayers, together with your own member document.
        allow create: if signedIn()
          && seatId.matches('p[1-8]')
          && int(seatId.replace('p', ''))
               <= getAfter(roomDoc(code)).data.settings.maxPlayers
          && getAfter(roomDoc(code)).data.status == 'lobby'
          && request.resource.data.keys().hasOnly(
               ['uid', 'name', 'color', 'joinedAt'])
          && request.resource.data.keys().hasAll(
               ['uid', 'name', 'color', 'joinedAt'])
          && request.resource.data.uid == request.auth.uid
          && validName(request.resource.data.name)
          && request.resource.data.color is int
          && request.resource.data.joinedAt == request.time
          && existsAfter(memberDoc(code, request.auth.uid))
          && getAfter(memberDoc(code, request.auth.uid)).data.role == 'player'
          && getAfter(memberDoc(code, request.auth.uid)).data.seat == seatId;

        // Taking over a seat after losing your identity: only if the person
        // sitting there has not been seen for 2 minutes, and only the uid
        // changes.
        allow update: if signedIn()
          && getAfter(roomDoc(code)).data.status != 'ended'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid
          && existsAfter(memberDoc(code, request.auth.uid))
          && getAfter(memberDoc(code, request.auth.uid)).data.role == 'player'
          && getAfter(memberDoc(code, request.auth.uid)).data.seat == seatId
          && get(presenceDoc(code, resource.data.uid)).data.lastSeen
               < request.time - duration.value(2, 'm');

        allow delete: if false;
      }

      // ---- members -----------------------------------------------------
      match /members/{memberId} {
        allow read: if isMember(code);

        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.keys().hasOnly(
               ['name', 'color', 'role', 'seat', 'pwHash'])
          && request.resource.data.keys().hasAll(
               ['name', 'color', 'role', 'seat'])
          && validName(request.resource.data.name)
          && request.resource.data.color is int
          && getAfter(roomDoc(code)).data.status != 'ended'
          && passwordOk(getAfter(roomDoc(code)).data, request.resource.data)
          && (request.resource.data.role == 'spectator'
              // A spectator has no seat and the room must allow spectators.
              ? request.resource.data.seat == null
                && getAfter(roomDoc(code)).data.settings.allowSpectators == true
              // A player holds a seat that is theirs after this write; once
              // the game has started that seat must already exist (taken over).
              : request.resource.data.role == 'player'
                && request.resource.data.seat is string
                && request.resource.data.seat.matches('p[1-8]')
                && getAfter(seatDoc(code, request.resource.data.seat)).data.uid
                     == request.auth.uid
                && (getAfter(roomDoc(code)).data.status == 'lobby'
                    || exists(seatDoc(code, request.resource.data.seat))));

        // A member may change their own name and colour, nothing else.
        allow update: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'color'])
          && validName(request.resource.data.name)
          && request.resource.data.color is int;

        // The member document of an identity that lost its seat can be removed
        // by whoever holds that seat now, in the same batch as the takeover.
        allow delete: if signedIn()
          && resource.data.role == 'player'
          && resource.data.seat is string
          && getAfter(seatDoc(code, resource.data.seat)).data.uid != memberId
          && getAfter(seatDoc(code, resource.data.seat)).data.uid
               == request.auth.uid;
      }

      // ---- presence ----------------------------------------------------
      // Everyone writes only their own, every minute; read one at a time when
      // a seat or the room has to be taken over.
      match /presence/{uid} {
        allow get: if isMember(code);
        allow list: if false;

        allow create, update: if signedIn()
          && uid == request.auth.uid
          && (isMember(code) || existsAfter(memberDoc(code, uid)))
          && request.resource.data.keys().hasOnly(['lastSeen'])
          && request.resource.data.keys().hasAll(['lastSeen'])
          && request.resource.data.lastSeen == request.time;

        allow delete: if false;
      }

      // ---- state -------------------------------------------------------
      // The balances at a glance, written when the game starts (here) and kept
      // up to date by the entries (later slice).
      match /state/{docId} {
        allow read: if isMember(code);

        allow create: if signedIn()
          && docId == 'current'
          && getAfter(roomDoc(code)).data.ownerUid == request.auth.uid
          && get(roomDoc(code)).data.status == 'lobby'
          && getAfter(roomDoc(code)).data.status == 'playing'
          && validStart(request.resource.data,
                        getAfter(roomDoc(code)).data.settings);

        // The numbers move only together with the entry that explains them:
        // the entry of the old seq must be created in the same transaction.
        allow update: if signedIn()
          && docId == 'current'
          && get(roomDoc(code)).data.status == 'playing'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['balances', 'seq'])
          && request.resource.data.seq is int
          && request.resource.data.seq == resource.data.seq + 1
          && existsAfter(entryPath(code, string(resource.data.seq)));

        // Taking back the latest entry gives the balances back and nothing
        // else: the counter stays, and that entry must be undone in the same
        // batch (its own rule checks the numbers).
        allow update: if signedIn()
          && docId == 'current'
          && get(roomDoc(code)).data.status == 'playing'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['balances'])
          && request.resource.data.seq == resource.data.seq
          && resource.data.seq > 0
          && get(entryPath(code, string(resource.data.seq - 1))).data.voided
               == false
          && getAfter(entryPath(code, string(resource.data.seq - 1))).data.voided
               == true;

        allow delete: if false;
      }

      // ---- entries -----------------------------------------------------
      // The history of the game, one line per press, written once. The only
      // change allowed is taking back the latest one (validVoid).
      match /entries/{entryId} {
        allow read: if isMember(code);
        allow create: if validEntry(code, entryId, request.resource.data);
        allow update: if validVoid(code, entryId, resource.data,
                                   request.resource.data);
        allow delete: if false;
      }

      // ---- requests ----------------------------------------------------
      // One request to pay per pair (asker_payer). Asking again writes over
      // the old one once it is closed or has run out.
      match /requests/{reqId} {
        allow read: if isMember(code);

        allow create: if validNewRequest(code, reqId, request.resource.data);

        allow update: if
          // asking again
          (validNewRequest(code, reqId, request.resource.data)
            && (resource.data.status != 'open'
                || resource.data.createdAt
                     < request.time - duration.value(2, 'm')))
          // the asker or the payer closes it
          || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status'])
            && resource.data.status == 'open'
            && request.resource.data.status == 'cancelled'
            && (get(seatDoc(code, resource.data.fromSeat)).data.uid
                  == request.auth.uid
                || get(seatDoc(code, resource.data.toSeat)).data.uid
                  == request.auth.uid))
          // the payer pays it
          || validRequestPaid(code, resource.data, request.resource.data);

        allow delete: if false;
      }
    }
  }
}
